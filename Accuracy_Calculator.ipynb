      "Significant figures: 4 Es = 0.005 %\n",
      "Significant figures: 5 Es = 0.0005 %\n",
      "Significant figures: 6 Es = 5e-05 %\n"
     ]
    }
   ],
   "source": [
    "for n in [3,4,5,6]:\n",
    "\n",
    "    print(\"Significant figures:\",\n",
    "          n,\n",
